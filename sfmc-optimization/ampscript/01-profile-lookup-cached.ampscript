%%[
/*==============================================================================
  Optimized profile personalization
  - One LookupRows for Loyalty_Profile
  - Defaults for empty / missing rows
  Place in email HTML or shared content block
==============================================================================*/

VAR @sk, @rows, @row, @firstName, @tier, @points, @cta

SET @sk = AttributeValue("SubscriberKey")
IF Empty(@sk) THEN
  SET @sk = subscriberkey
ENDIF

SET @rows = LookupRows("Loyalty_Profile", "SubscriberKey", @sk)

IF RowCount(@rows) > 0 THEN
  SET @row = Row(@rows, 1)
  SET @firstName = Field(@row, "FirstName")
  SET @tier = Field(@row, "Tier")
  SET @points = Field(@row, "Points")
ELSE
  SET @firstName = ""
  SET @tier = "Member"
  SET @points = "0"
ENDIF

IF Empty(@firstName) THEN
  SET @firstName = "there"
ENDIF

IF Uppercase(@tier) == "GOLD" THEN
  SET @cta = "See your Gold rewards"
ELSEIF Uppercase(@tier) == "SILVER" THEN
  SET @cta = "Unlock Gold this month"
ELSE
  SET @cta = "Explore your benefits"
ENDIF
]%%

<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td>
      <p style="margin:0 0 12px 0;font-size:18px;line-height:1.4;">
        Hi %%=v(@firstName)=%%,
      </p>
      <p style="margin:0 0 12px 0;font-size:16px;line-height:1.5;">
        You're on <strong>%%=v(@tier)=%%</strong> with
        <strong>%%=v(@points)=%%</strong> points.
      </p>
      <p style="margin:0;font-size:16px;line-height:1.5;">
        %%=v(@cta)=%%.
      </p>
    </td>
  </tr>
</table>
